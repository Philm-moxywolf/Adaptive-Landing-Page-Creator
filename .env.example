# ──────────────────────────────────────────────────────────────────────────────
# Adaptive Landing Page Creator — environment variables
# Copy this file to `.env.local` and fill in the values for YOUR deployment.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser (safe for IDs, not secrets).
# ──────────────────────────────────────────────────────────────────────────────

# ── Analytics (client-side) ───────────────────────────────────────────────────
# Your GA4 Measurement ID, e.g. G-XXXXXXXXXX. Found in GA4 > Admin > Data Streams.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# The public URL of the deployed site, e.g. https://offer.yourdomain.com
# Used for canonical URLs, sitemap, OpenGraph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Server-side conversion tracking (GA4 Measurement Protocol) ─────────────────
# Lets the /api/lead route send a server-verified conversion event to GA4 even if
# the client blocks tags. Create in GA4 > Admin > Data Streams > Measurement Protocol API secrets.
GA4_MEASUREMENT_PROTOCOL_SECRET=

# ── Lead handling ──────────────────────────────────────────────────────────────
# Where form submissions are forwarded (your CRM / Zapier / Make / webhook). Optional.
LEAD_WEBHOOK_URL=

# ── Weekly optimizer (GitHub Action / local `npm run optimize`) ────────────────
# GA4 Property ID (numeric, NOT the G- id). GA4 > Admin > Property Settings.
GA4_PROPERTY_ID=

# Google service-account credentials with "Viewer" access to the GA4 property.
# Provide ONE of the following:
#   (a) Path to the JSON key file (local dev):
GOOGLE_APPLICATION_CREDENTIALS=./optimizer/.secrets/ga4-service-account.json
#   (b) The full JSON blob as a single-line string (CI / Vercel):
GA4_SERVICE_ACCOUNT_JSON=

# Anthropic API key — powers the copy/element rewrite + live ICP research.
ANTHROPIC_API_KEY=

# Optional: override the optimizer model (defaults to claude-opus-4-8 for max quality).
OPTIMIZER_MODEL=claude-opus-4-8
